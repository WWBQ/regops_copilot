# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=regops
POSTGRES_PASSWORD=regops123
POSTGRES_DB=regops_db
DATABASE_URL=postgresql://regops:regops123@localhost:5432/regops_db

# LLM API（W1 填入真实 Key，复制本文件为 .env）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DEFAULT_MODEL=deepseek-flash
# 前端展示具体模型 ID；旧的 DEFAULT_MODEL=deepseek/qwen 仍可作为别名使用。
# 增加同一供应商的型号时用逗号分隔，无需修改 Python 代码。
DEEPSEEK_MODEL_IDS=deepseek-flash,deepseek-v4-pro
QWEN_MODEL_IDS=qwen3.8-max,qwen3.8-flash,qwen3.7-plus
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java JWT（至少 32 字符；演示账号见 docs/W7_RBAC.md）
REGOPS_JWT_SECRET=dev-regops-jwt-secret-change-me-32b

# Java → Python 服务身份（Compose 与本地 dev.sh 共用）
REGOPS_SERVICE_TOKEN=dev-service-token

# Compose 内 Java 会覆盖为 http://python-ai:8000；本地开发保持 localhost
# REGOPS_PYTHON_AI_BASE_URL=http://localhost:8000

# 可选：Langfuse Cloud / 自建。不填则只写 Python 进程内 Trace 缓冲。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# PDF 解析：docling 默认可用；mineru 需先安装 python-ai/requirements-mineru.txt
DOCUMENT_PARSER_BACKEND=docling
MINERU_TIER=standard
MINERU_OCR_MODE=auto

# RAG 重排：默认 BGE。本地或远程 LLM 均通过 OpenAI 兼容接口接入。
RAG_RERANK_ENABLED=true
RAG_RERANK_BACKEND=bge
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATES=80

# 仅在 RAG_RERANK_BACKEND=llm 时使用。
# local 示例：直接运行用 http://127.0.0.1:11434/v1；Compose 访问宿主机 Ollama
# 在 macOS/Windows 使用 http://host.docker.internal:11434/v1；vLLM 同样使用其 /v1 地址。
# api 模式会把候选文档片段发送给所配置的外部模型服务。
RAG_LLM_RERANK_DEPLOYMENT=local
RAG_LLM_RERANK_MODEL=
RAG_LLM_RERANK_BASE_URL=
RAG_LLM_RERANK_API_KEY=local
RAG_LLM_RERANK_CANDIDATES=12
RAG_LLM_RERANK_MAX_CHARS=800

# 可选：OTel Collector。本仓库跨进程契约是 W3C traceparent，不强制 Collector。
# OTEL_EXPORTER_OTLP_ENDPOINT=

# 可选：W8-4 Dify 对照（独立编排 :1380，不进根 compose）
# DIFY_BASE_URL=http://localhost:1380/v1
# DIFY_APP_KEY=
