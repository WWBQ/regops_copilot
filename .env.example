# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=regops
POSTGRES_PASSWORD=regops123
POSTGRES_DB=regops_db
DATABASE_URL=postgresql://regops:regops123@localhost:5432/regops_db
RABBITMQ_PASSWORD=regops
INGEST_BROKER_URL=amqp://regops:regops@localhost:5672//
INGEST_RESULT_BACKEND=redis://localhost:6379/1
# Agent 默认复用 DATABASE_URL；仅需单独数据库时设置此项。
# AGENT_DATABASE_URL=postgresql://regops:regops123@localhost:5432/regops_db

# LLM API（W1 填入真实 Key，复制本文件为 .env）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# 金融 Agent 内部 Web Search。默认使用本地 SearXNG，Zhipu/Brave 是可切换备用。
FIN_RISK_WEB_SEARCH_PROVIDER=searxng
FIN_RISK_WEB_FALLBACK_PROVIDERS=zhipu,brave
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_SECRET=change-me
ZHIPU_API_KEY=
BRAVE_SEARCH_API_KEY=
# 只接收这些域名及其子域；可按部署环境调整。
FIN_RISK_WEB_ALLOWED_DOMAINS=csrc.gov.cn,sse.com.cn,szse.cn,cninfo.com.cn,bse.cn,samr.gov.cn,court.gov.cn,wenshu.court.gov.cn,zxgk.court.gov.cn,xinhua.com,people.com.cn,stcn.com,cs.com.cn,cnstock.com,yicai.com,caixin.com
FIN_RISK_WEB_TIMEOUT_SECONDS=10
FIN_RISK_WEB_CACHE_TTL_SECONDS=600
FIN_RISK_WEB_MAX_CALLS_PER_RUN=2
# 金融 Agent 单轮工具总预算（财务事实、年报证据、外部搜索合计）。
AGENT_FINANCIAL_AUDIT_MAX_TOOL_CALLS=20
AGENT_FINANCIAL_AUDIT_MAX_SECONDS=300
DEFAULT_MODEL=deepseek-flash
# 金融风险审计助手的默认模型；页面可在每轮发送前切换具体型号。
MAIN_MODEL=deepseek-v4-pro
# 前端展示具体模型 ID；旧的 DEFAULT_MODEL=deepseek/qwen 仍可作为别名使用。
# 增加同一供应商的型号时用逗号分隔，无需修改 Python 代码。
DEEPSEEK_MODEL_IDS=deepseek-flash,deepseek-v4-pro
QWEN_MODEL_IDS=qwen3.8-max,qwen3.8-flash,qwen3.7-plus
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1400
# 启动时加载本地 Embedding/BGE，并缓存模型客户端；失败只记日志，不阻止服务启动。
STARTUP_WARMUP_ENABLED=true

# Java JWT（至少 32 字符；演示账号见 docs/W7_RBAC.md）
REGOPS_JWT_SECRET=dev-regops-jwt-secret-change-me-32b

# Java → Python 服务身份（Compose 与本地 dev.sh 共用）
REGOPS_SERVICE_TOKEN=dev-service-token
# 金融 MCP 服务访问 RegOps Python API；Compose 内运行时使用 http://python-ai:8000
REGOPS_API_BASE_URL=http://127.0.0.1:8000
REGOPS_MCP_URL=http://127.0.0.1:8000/mcp/

# Compose 内 Java 会覆盖为 http://python-ai:8000；本地开发保持 localhost
# REGOPS_PYTHON_AI_BASE_URL=http://localhost:8000

# 可选：Langfuse Cloud / 自建。不填则只写 Python 进程内 Trace 缓冲。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# PDF 解析：docling 默认可用；mineru 需先安装 python-ai/requirements-mineru.txt
DOCUMENT_PARSER_BACKEND=docling
MINERU_TIER=standard
MINERU_OCR_MODE=auto

# Embedding 与基础检索
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=auto
# 默认仅从本地缓存加载，防止解析 Worker 等待模型站点；首次预下载时可临时设为 false。
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_MIN_SCORE=0.42
RAG_TOP_K=12
RAG_VECTOR_FETCH_K=80
RAG_KEYWORD_TOP_K=30
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
RAG_RRF_K=60
RAG_VECTOR_RRF_WEIGHT=2.0
RAG_KEYWORD_RRF_WEIGHT=1.0
RAG_ENUM_KEYWORD_RRF_WEIGHT=0.0
RAG_SECTION_TITLE_BOOST=3
RAG_MAX_CHUNKS_PER_PAGE=2

# RAG 重排：默认 BGE。本地或远程 LLM 均通过 OpenAI 兼容接口接入。
RAG_RERANK_ENABLED=true
RAG_RERANK_BACKEND=bge
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATES=12

# 多公司比较先按公司/年份缩小范围，再各自重排。
RAG_COMPARE_RERANK_CANDIDATES=12
RAG_COMPARE_TOP_K_PER_COMPANY=6
RAG_COMPARE_MIN_HITS_PER_COMPANY=1
RAG_TRACE_ENABLED=true

# 仅在 RAG_RERANK_BACKEND=llm 时使用。
# local 示例：直接运行用 http://127.0.0.1:11434/v1；Compose 访问宿主机 Ollama
# 在 macOS/Windows 使用 http://host.docker.internal:11434/v1；vLLM 同样使用其 /v1 地址。
# api 模式会把候选文档片段发送给所配置的外部模型服务。
RAG_LLM_RERANK_DEPLOYMENT=local
RAG_LLM_RERANK_MODEL=
RAG_LLM_RERANK_BASE_URL=
RAG_LLM_RERANK_API_KEY=local
RAG_LLM_RERANK_CANDIDATES=12
RAG_LLM_RERANK_MAX_CHARS=800
RAG_LLM_RERANK_MAX_OUTPUT_TOKENS=800

# 可选：OTel Collector。本仓库跨进程契约是 W3C traceparent，不强制 Collector。
# OTEL_EXPORTER_OTLP_ENDPOINT=

# 可选：W8-4 Dify 对照（独立编排 :1380，不进根 compose）
# DIFY_BASE_URL=http://localhost:1380/v1
# DIFY_APP_KEY=
