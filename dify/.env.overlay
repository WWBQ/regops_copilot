# 覆盖官方 docker/.env 的对外端口与 URL。
# 避开本仓库占用的 5173 / 8000 / 8080 / 8088 / 5432。
# 用法：scripts/dify-up.sh 会把它追加进 dify/upstream/docker/.env

EXPOSE_NGINX_PORT=1380
EXPOSE_NGINX_SSL_PORT=1381
EXPOSE_PLUGIN_DEBUGGING_PORT=15003

CONSOLE_API_URL=http://localhost:1380
CONSOLE_WEB_URL=http://localhost:1380
SERVICE_API_URL=http://localhost:1380
APP_API_URL=http://localhost:1380
APP_WEB_URL=http://localhost:1380
FILES_URL=http://localhost:1380
TRIGGER_URL=http://localhost:1380
NEXT_PUBLIC_SOCKET_URL=ws://localhost:1380
ENDPOINT_URL_TEMPLATE=http://localhost:1380/e/{hook_id}
