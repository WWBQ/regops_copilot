{
  "version": "eval-tasks-v1",
  "tasks": [
    {
      "id": "w1_chat",
      "name": "W1 聊天评测",
      "description": "30 题闭卷金融能力：监管制度 + 会计/银行/市场概念（/chat，use_rag=false）",
      "golden_file": "w1_chat_30.json",
      "runner": "w1_chat",
      "metrics": [
        "accuracy",
        "refuse_rate",
        "latency_p50_ms"
      ],
      "builtin": true
    },
    {
      "id": "rag_retrieval",
      "name": "RAG 检索评测",
      "description": "100 题：Hybrid 检索 page 粒度 Recall@k / MRR / nDCG@k / citation_accuracy",
      "golden_file": "rag_retrieval_100.json",
      "runner": "rag_retrieval",
      "metrics": [
        "recall_at_k",
        "mrr",
        "ndcg_at_k",
        "citation_accuracy"
      ],
      "builtin": true
    },
    {
      "id": "compliance_schema",
      "name": "合规结论 Schema 校验",
      "description": "20 例：10 合法 + 10 非法，统计误放行/误拒与报错理由命中率",
      "golden_file": "compliance_schema_20.json",
      "runner": "compliance_schema",
      "metrics": [
        "accuracy",
        "false_accept_rate",
        "false_reject_rate"
      ],
      "builtin": true
    },
    {
      "id": "w4_asknum",
      "name": "W4 问数评测",
      "description": "20 题：命中 / 拦截 / 反问 / 跳过，检查路由与数字泄露（不调 LLM）",
      "golden_file": "w4_asknum_20.json",
      "runner": "w4_asknum",
      "metrics": [
        "accuracy",
        "route_accuracy",
        "leak_rate"
      ],
      "builtin": true
    },
    {
      "id": "w6_number_check",
      "name": "W6 数字校验",
      "description": "20 例：抽取终稿数字并回溯事实/引用，统计误放行与量纲错误（不调 LLM）",
      "golden_file": "w6_number_check_20.json",
      "runner": "w6_number_check",
      "metrics": [
        "accuracy",
        "false_accept_rate",
        "number_error_rate",
        "unit_error_rate"
      ],
      "builtin": true
    },
    {
      "id": "w8_strategy",
      "name": "W8 三策略对照",
      "description": "30 题：Zero-shot / Few-shot / CoT，对照准确率、数字错误率、Token、延迟（默认 fixture）",
      "golden_file": "w8_prompt_30.json",
      "runner": "w8_strategy",
      "metrics": [
        "accuracy",
        "number_error_rate",
        "avg_tokens",
        "latency_p50_ms"
      ],
      "builtin": true
    },
    {
      "id": "w8_ab",
      "name": "W8 Prompt A/B",
      "description": "同一 30 题、固定种子、随机顺序；Wilson / McNemar，n=30 提升 3% 通常不可信",
      "golden_file": "w8_prompt_30.json",
      "runner": "w8_ab",
      "metrics": [
        "accuracy",
        "delta",
        "mcnemar_p",
        "credible"
      ],
      "builtin": true
    },
    {
      "id": "rag_acl",
      "name": "RAG 部门 ACL",
      "description": "20 题：检索层按部门裁剪公司年报；越权不得落到禁止的 company_code（不调 LLM）",
      "golden_file": "rag_acl_20.json",
      "runner": "rag_acl",
      "metrics": [
        "accuracy",
        "false_accept_rate",
        "leak_rate"
      ],
      "builtin": true
    },
    {
      "id": "rag_refuse",
      "name": "RAG 无答案拒答",
      "description": "20 题：寒暄 no_intent；库外公司 / 缺少年报年份 no_docs（不调 LLM）",
      "golden_file": "rag_refuse_20.json",
      "runner": "rag_refuse",
      "metrics": [
        "accuracy",
        "false_accept_rate"
      ],
      "builtin": true
    },
    {
      "id": "rag_support",
      "name": "RAG 引用片段撑住答案",
      "description": "20 题：检索片段是否覆盖 must_contain；与页级 Recall 分开，不调 LLM",
      "golden_file": "rag_support_20.json",
      "runner": "rag_support",
      "metrics": [
        "support_hit_rate",
        "support_coverage"
      ],
      "builtin": true
    },
    {
      "id": "rag_compare",
      "name": "多公司 RAG 证据门",
      "description": "16 题：公司隔离、共同期间、部门 ACL 与任一方低证据拒绝（不调 LLM）",
      "golden_file": "rag_compare_16.json",
      "runner": "rag_compare",
      "metrics": [
        "accuracy",
        "route_accuracy",
        "company_scope_accuracy",
        "period_accuracy",
        "false_compare_rate"
      ],
      "builtin": true
    }
  ]
}
