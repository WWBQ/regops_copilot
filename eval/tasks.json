{
  "version": "eval-tasks-v1",
  "tasks": [
    {
      "id": "w1_chat",
      "name": "W1 聊天评测",
      "description": "30 题闭卷金融能力：监管制度 + 会计/银行/市场概念（/chat，use_rag=false）",
      "golden_file": "w1_chat_30.json",
      "runner": "w1_chat",
      "metrics": [
        "accuracy",
        "refuse_rate",
        "latency_p50_ms"
      ],
      "builtin": true
    },
    {
      "id": "rag_retrieval",
      "name": "RAG 检索评测",
      "description": "100 题：Hybrid 检索 page 粒度 Recall@k / MRR",
      "golden_file": "rag_retrieval_100.json",
      "runner": "rag_retrieval",
      "metrics": [
        "recall_at_k",
        "mrr"
      ],
      "builtin": true
    },
    {
      "id": "compliance_schema",
      "name": "合规结论 Schema 校验",
      "description": "20 例：10 合法 + 10 非法，统计误放行/误拒与报错理由命中率",
      "golden_file": "compliance_schema_20.json",
      "runner": "compliance_schema",
      "metrics": [
        "accuracy",
        "false_accept_rate",
        "false_reject_rate"
      ],
      "builtin": true
    },
    {
      "id": "w4_asknum",
      "name": "W4 问数评测",
      "description": "20 题：命中 / 拦截 / 反问 / 跳过，检查路由与数字泄露（不调 LLM）",
      "golden_file": "w4_asknum_20.json",
      "runner": "w4_asknum",
      "metrics": [
        "accuracy",
        "route_accuracy",
        "leak_rate"
      ],
      "builtin": true
    },
    {
      "id": "w6_number_check",
      "name": "W6 数字校验",
      "description": "20 例：抽取终稿数字并回溯事实/引用，统计误放行与量纲错误（不调 LLM）",
      "golden_file": "w6_number_check_20.json",
      "runner": "w6_number_check",
      "metrics": [
        "accuracy",
        "false_accept_rate",
        "number_error_rate",
        "unit_error_rate"
      ],
      "builtin": true
    },
    {
      "id": "w6_workflow",
      "name": "W6 工作流轨迹",
      "description": "20 场景：节点顺序、工具参数、确认率和失败节点（不调 LLM）",
      "golden_file": "w6_workflow_20.json",
      "runner": "w6_workflow",
      "metrics": [
        "accuracy",
        "param_accuracy",
        "avg_steps",
        "confirmation_rate"
      ],
      "builtin": true
    },
    {
      "id": "w8_strategy",
      "name": "W8 四策略对照",
      "description": "30 题：Zero-shot / Few-shot / CoT / ReAct，对照准确率、数字错误率、Token、延迟（默认 fixture）",
      "golden_file": "w8_prompt_30.json",
      "runner": "w8_strategy",
      "metrics": [
        "accuracy",
        "number_error_rate",
        "avg_tokens",
        "latency_p50_ms"
      ],
      "builtin": true
    },
    {
      "id": "w8_ab",
      "name": "W8 Prompt A/B",
      "description": "同一 30 题、固定种子、随机顺序；Wilson / McNemar，n=30 提升 3% 通常不可信",
      "golden_file": "w8_prompt_30.json",
      "runner": "w8_ab",
      "metrics": [
        "accuracy",
        "delta",
        "mcnemar_p",
        "credible"
      ],
      "builtin": true
    },
    {
      "id": "w9_redteam",
      "name": "W9 金融红队",
      "description": "25 条：注入 / 越权 / SQL / PII / 诱导编造；证明边界在代码不在 Prompt（不调 LLM）",
      "golden_file": "w9_redteam_25.json",
      "runner": "w9_redteam",
      "metrics": [
        "accuracy",
        "sql_leak_rate",
        "acl_leak_rate",
        "number_error_rate"
      ],
      "builtin": true
    }
  ]
}
